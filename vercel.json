{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/**/*.py": {
          "includeFiles": "models/license_plate.onnx"
        }
      },
      "routes": [
        {
          "src": "/api",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/"
            }
          ]
        },
        {
          "src": "/api/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
