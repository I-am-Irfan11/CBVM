# Explicit ephemeral demo storage; set mongodb for local MongoDB or Atlas.
DATABASE_MODE=memory
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=gatelog
USE_MOCK_AI=true
SEED_ON_STARTUP=true
YOLO_MODEL_PATH=models/license_plate.pt
OCR_CONFIDENCE_THRESHOLD=0.80
DUPLICATE_COOLDOWN_SECONDS=30
VIDEO_SOURCE=mock
RTSP_URL=
VIDEO_FILE=
WEBCAM_INDEX=0
FRAME_SAMPLE_RATE=2
RUN_VIDEO_WORKER=false
CAMERA_ID=main-gate-in
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://cbvm.vercel.app"]
CAMPUS_TIMEZONE=Asia/Kolkata
# Expiry applies to completed visits, resolved reviews and audit records only.
RETENTION_DAYS=90
# Supabase Auth validates Google sign-in. Restrict accounts to explicit emails
# and/or email domains; admin emails are also automatically allowed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ALLOWED_EMAILS=
SUPABASE_ALLOWED_DOMAINS=
SUPABASE_ADMIN_EMAILS=
# Private Cloudflare R2 scan-image storage. Leave empty until the bucket is ready.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_EXPIRY_SECONDS=300
# Persistent deployment requires a private JWT_SECRET_KEY of at least 32 characters.
COOKIE_SECURE=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_OPERATIONAL_DATA=false
RECONNECT_DELAY_SECONDS=1
# Public API base used by the frontend. "/api" is the same-origin path the Vercel
# rewrite routes to the backend (and the local Vite dev proxy mirrors it).
VITE_API_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
