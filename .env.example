# Development MUST use a separate MongoDB database, never the live campus database.
APP_ENV=development
DATABASE_MODE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=gatelog_dev
USE_MOCK_AI=false
SEED_ON_STARTUP=false
YOLO_MODEL_PATH=models/license_plate.pt
OCR_CONFIDENCE_THRESHOLD=0.80
DUPLICATE_COOLDOWN_SECONDS=30
VIDEO_SOURCE=webcam
RTSP_URL=
VIDEO_FILE=
WEBCAM_INDEX=0
FRAME_SAMPLE_RATE=2
RUN_VIDEO_WORKER=false
CAMERA_ID=main-gate-in
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://cbvm.vercel.app"]
CAMPUS_TIMEZONE=Asia/Kolkata
# Expiry applies to completed visits, resolved reviews and audit records only.
RETENTION_DAYS=90
# Supabase Auth validates Google sign-in. Restrict accounts to explicit emails
# and/or email domains; admin emails are also automatically allowed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ALLOWED_EMAILS=
SUPABASE_ALLOWED_DOMAINS=
SUPABASE_ADMIN_EMAILS=
# Private Cloudflare R2 scan-image storage. Leave empty until the bucket is ready.
R2_ENDPOINT_URL=
RETAIN_SCAN_IMAGES=false
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_EXPIRY_SECONDS=300
SEED_OPERATIONAL_DATA=false
RECONNECT_DELAY_SECONDS=1
# Demo bypass. When true, /auth/* stops checking credentials, sessions and CSRF
# and every visitor signs in through a dummy entrance as "admin". Local demos
# only. NEVER set this on a public deployment: it exposes every record, the user
# list and the audit log to anonymous callers. Note the frontend sets its demo
# marker cookie without Secure, so keep COOKIE_SECURE=false while this is on.
DEMO_OPEN_ACCESS=false
# Public API base used by the frontend. "/api" is the same-origin path the Vercel
# rewrite routes to the backend (and the local Vite dev proxy mirrors it).
VITE_API_URL=/api
# Generated locally by scripts/bootstrap_env.py; set independently on the server.
JWT_SECRET_KEY=
# Persistent deployment requires a private JWT_SECRET_KEY of at least 32 characters.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
