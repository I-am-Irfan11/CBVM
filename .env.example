# Explicit ephemeral demo storage; set mongodb for local MongoDB or Atlas.
DATABASE_MODE=memory
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=gatelog
USE_MOCK_AI=true
SEED_ON_STARTUP=true
YOLO_MODEL_PATH=models/license_plate.pt
OCR_CONFIDENCE_THRESHOLD=0.80
DUPLICATE_COOLDOWN_SECONDS=30
VIDEO_SOURCE=mock
RTSP_URL=
VIDEO_FILE=
WEBCAM_INDEX=0
FRAME_SAMPLE_RATE=2
RUN_VIDEO_WORKER=false
CAMERA_ID=main-gate-in
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CAMPUS_TIMEZONE=Asia/Kolkata
# Expiry applies to completed visits, resolved reviews and audit records only.
RETENTION_DAYS=90
# Cloudflare Access validates Google sign-in at the edge. Set both values from the
# Access application before exposing GateLog. Restrict allowed emails in Access.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=
# Comma-separated Google email addresses that receive the admin role.
CLOUDFLARE_ADMIN_EMAILS=
# Private Cloudflare R2 scan-image storage. Leave empty until the bucket is ready.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_EXPIRY_SECONDS=300
# Persistent deployment requires a private JWT_SECRET_KEY of at least 32 characters.
COOKIE_SECURE=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_OPERATIONAL_DATA=false
RECONNECT_DELAY_SECONDS=1
VITE_API_URL=http://127.0.0.1:8000
